{
  "name": "ListenFlow — Neural Text to Speech",
  "short_name": "ListenFlow",
  "description": "Convert PDFs, Word docs, eBooks, web articles, and on-screen text into natural neural speech.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0b0d14",
